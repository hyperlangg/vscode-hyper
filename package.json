{
  "name": "hyper",
  "displayName": "Hyper",
  "description": "Language support for Hyper: syntax highlighting, Hyper Analyzer diagnostics, completions, hover, and go to definition.",
  "version": "0.1.0",
  "publisher": "hyperlangg",
  "license": "MIT OR Apache-2.0",
  "icon": "doc/images/hyper-light.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "keywords": [
    "hyper",
    "hyp",
    "syntax",
    "highlighting",
    "lsp",
    "analyzer",
    "go to definition"
  ],
  "homepage": "https://github.com/hyperlangg/vscode-hyper",
  "bugs": {
    "url": "https://github.com/hyperlangg/vscode-hyper/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hyperlangg/vscode-hyper.git"
  },
  "activationEvents": [
    "onLanguage:hyper"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "tsc -p ./ && node dist/test/analyzer.test.js",
    "vscode:prepublish": "npm test",
    "package": "npx --yes @vscode/vsce package"
  },
  "contributes": {
    "languages": [
      {
        "id": "hyper",
        "aliases": [
          "Hyper",
          "hyper"
        ],
        "extensions": [
          ".hyp"
        ],
        "icon": {
          "light": "./doc/images/hyper-light.png",
          "dark": "./doc/images/hyper-dark.png"
        },
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "hyper",
        "scopeName": "source.hyper",
        "path": "./syntaxes/hyper.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Hyper",
      "properties": {
        "hyper-analyzer.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Traces communication between VS Code and Hyper Analyzer."
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.6.0"
  }
}
