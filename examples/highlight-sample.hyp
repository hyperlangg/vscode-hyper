# Hyper language sample — syntax highlighting preview

# Comments use # like Python

import math as m
from pointmod import Point

let nums = [1, 2, 3]
let mut total: i64 = 0

for i in range(4):
    total = total + i
    if i == 2:
        continue
    elif i > 10:
        break
    else:
        print(i)

@parallel
for j in range(1_000):
    process(j)

@vectorize
for k in range(8):
    total += k

fn add(a: i32, b: i32) -> i32:
    return a + b

def greet(who: string) -> string:
    return f"hi {who}"

fn boom(x: i64) raises -> i64:
    if x < 0:
        raise "negative"
    return x * 2

print(handle boom(3) else -1)
print(true and false or not None)

trait Speaker:
    fn speak(ref self) -> string

struct Dog(Speaker):
    let pub name: string
    let mut age: i32

    pub fn __init__(ref self, name: string, age: i32):
        self.name = name
        self.age = age

    pub fn speak(ref self) -> string:
        return f"Woof! I'm {self.name}"

let dog = Dog(name: "Tuzlon", age: 3)
print(dog.speak())

arr: Array[int32] = [10, 20, 30]
d: Dict[string, i64] = {"a": 1, "b": 2}

with open("data.txt", "r") as f:
    print(f.read())
